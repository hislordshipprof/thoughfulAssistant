{
  "name": "thoughtful",
  "version": "1.0.0",
  "description": "Thoughtful — invisible AI-powered interview overlay",
  "main": "out/main/main.js",
  "private": true,
  "scripts": {
    "install": "node -e \"process.exit(0)\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --win",
    "package:win": "npm run build && npm run rebuild && electron-builder --win",
    "package:mac": "npm run build && npm run rebuild && electron-builder --mac",
    "package:mac:arm64": "npm run build && npm run rebuild && electron-builder --mac --arm64",
    "package:mac:x64": "npm run build && npm run rebuild && electron-builder --mac --x64",
    "package:all": "npm run build && npm run rebuild && electron-builder -mw",
    "rebuild": "node scripts/rebuild-native.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "electron-store": "^8.2.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.4.1",
    "node-addon-api": "^8.3.1",
    "openai": "^4.77.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "tesseract.js": "^5.1.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
