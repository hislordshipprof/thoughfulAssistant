# ── AI Providers (for chat/reasoning) ──
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ── Speech-to-Text Providers ──
# Deepgram (default, best — streaming, ~300ms latency)
DEEPGRAM_API_KEY=

# Groq Whisper (fast batch, 216x real-time)
GROQ_API_KEY=gsk_your-groq-key-here

# Google Cloud Speech-to-Text (batch)
GOOGLE_STT_API_KEY=AIza-your-google-key-here
GOOGLE_PROJECT_ID=my-project-123
